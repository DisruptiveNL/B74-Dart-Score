<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camera: required for QR code scanning (mobile_scanner) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Network: required for WiFi sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Wi-Fi: needed to raise the temporary network a transfer can run over,
        and to join one another device raised. NEARBY_WIFI_DEVICES carries
        neverForLocation on purpose, so none of this asks for the user's
        location. The feature is gated at Android 13 for the same reason: below
        that the same APIs want ACCESS_FINE_LOCATION and GPS switched on.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:label="B74 Dart Score"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                A backup or a profile arriving from anywhere: Nearby Share,
                Drive, mail, a chat.

                Three filters, because Android matches a file three ways and no
                one of them covers the rest. They must stay apart: a filter that
                names a mimeType stops looking at the path, so combining the two
                silently disables the pathPattern.

                Whichever way a file gets here, the name is only how it arrives.
                What it actually is gets read out of it before anything is
                replaced.
            -->
            <!-- 1. The type this app announces its own files under. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.ratka.dartscore"/>
                <data android:mimeType="application/vnd.ratka.dartsync"/>
            </intent-filter>
            <!--
                2. A plain path, where the extension is all there is to go on.
                No mimeType here on purpose, see above.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="file"/>
                <data android:scheme="content"/>
                <data android:host="*"/>
                <data android:pathPattern=".*\\.dartscore"/>
                <data android:pathPattern=".*\\..*\\.dartscore"/>
                <data android:pathPattern=".*\\..*\\..*\\.dartscore"/>
                <data android:pathPattern=".*\\.dartsync"/>
                <data android:pathPattern=".*\\..*\\.dartsync"/>
                <data android:pathPattern=".*\\..*\\..*\\.dartsync"/>
            </intent-filter>
            <!--
                3. The catch-all, and the reason DartScore turns up under "open
                with" for files that are none of its business. Android has no
                idea what a .dartscore is, so anything arriving from a sender
                that did not use filter 1 comes through as a nameless blob. The
                app reads the first bytes and turns down what is not its own,
                so nothing worse than a wrong entry in a list can come of it.
                Delete this block if that entry is more annoying than the
                feature is useful.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
            <!--
                4. Sharing, which on Android is the route people actually use
                and the only one some file managers offer at all. Samsung's own
                looks an unknown extension up in a table of its own, finds
                nothing and shows the Play Store instead: it never asks the
                system who could open the file, so no VIEW filter above is ever
                consulted. Sharing goes around that.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.ratka.dartscore"/>
                <data android:mimeType="application/vnd.ratka.dartsync"/>
                <data android:mimeType="application/octet-stream"/>
            </intent-filter>
        </activity>
        <!-- The barcode model is not bundled with the app (see useUnbundled in
             gradle.properties). This asks Play Services to fetch it right after
             the install, so the first scan does not have to wait for it. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
